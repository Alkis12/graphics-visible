# Application
APP_HOST=127.0.0.1
APP_PORT=8080
TRUST_PROXY=false
COOKIE_SECURE=false
SESSION_SECRET=
BCRYPT_ROUNDS=12

# MongoDB
MONGO_DB=graphics_visible
MONGO_ROOT_USER=graphics_visible_admin
MONGO_ROOT_PASSWORD=
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_URL=

# Seeded application accounts
ADMIN_USERNAME=admin
ODEON_USERNAME=client_manager

# Optional account-maintenance script
ODEON_PULSE_USERNAME=

# ETL worker and optional source database
ETL_LOG_LEVEL=INFO
ETL_POLL_SECONDS=3
PLANETRA_DB_HOST=
PLANETRA_DB_PORT=5432
PLANETRA_DB_NAME=
PLANETRA_DB_USER=
PLANETRA_DB_PASSWORD=

# Optional remote deployment and SSH tunnel
DEPLOY_TARGET=local
PROD_HOST=
PROD_APP_DIR=
EXTERNAL_NETWORK_NAME=
SERVER_SSH=
LOCAL_MONGO_PORT=27018
REMOTE_MONGO_PORT=27018
